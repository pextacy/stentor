{
  "lang": "en",
  "name": "English",
  "english_name": "English",
  "dir": "ltr",
  "tts": "en-US",
  "reviewed_by": "source language",
  "approved": false,
  "fold_diacritics": true,
  "word_boundary": true,
  "negation_markers": ["not", "don't", "dont", "never", "no"],
  "headline": "{name} warning.",
  "headline_place": "{name} warning for {P}.",
  "hazards": {
    "wildfire": {"name": "Wildfire", "terms": ["brush fire", "forest fire", "grass fire"]},
    "flood": {"name": "Flood", "terms": ["flash flood", "flooding"]},
    "earthquake": {"name": "Earthquake", "terms": ["aftershock"]},
    "tsunami": {"name": "Tsunami", "terms": []},
    "hurricane": {"name": "Hurricane", "terms": ["tropical storm", "typhoon"]},
    "tornado": {"name": "Tornado", "terms": []},
    "extreme_heat": {"name": "Extreme heat", "terms": ["heat wave", "excessive heat"]},
    "hazmat": {"name": "Chemical hazard", "terms": ["chemical spill", "chemical", "hazardous material", "gas leak", "toxic"]},
    "active_threat": {"name": "Active shooter", "terms": ["active threat", "armed person"]},
    "boil_water": {"name": "Water contamination", "terms": ["boil water notice", "boil water advisory", "contaminated water"]},
    "other": {"name": "Emergency", "terms": []}
  },
  "actions": {
    "evacuate_now": {"match": ["evacuate now", "evacuate immediately", "leave now", "evacuation order"],
      "text": {"": "Evacuate now.", "P": "Evacuate now via {P}.", "T": "Evacuate now, before {T}."}},
    "prepare_to_evacuate": {"match": ["prepare to evacuate", "be ready to evacuate", "evacuation warning"],
      "text": {"": "Prepare to evacuate.", "P": "Prepare to evacuate via {P}.", "T": "Prepare to evacuate by {T}."}},
    "shelter_in_place": {"match": ["shelter in place", "take shelter"],
      "text": {"": "Shelter in place now."}},
    "move_to_higher_ground": {"match": ["move to higher ground", "go to higher ground", "get to high ground"],
      "text": {"": "Move to higher ground now."}},
    "stay_indoors": {"match": ["stay indoors", "stay inside", "remain indoors"],
      "text": {"": "Stay indoors.", "T": "Stay indoors until {T}."}},
    "avoid_area": {"match": ["avoid the area", "stay away from"],
      "text": {"": "Avoid the area.", "P": "Stay away from {P}."}},
    "boil_water": {"match": ["boil water", "boil all water", "boil tap water"],
      "text": {"": "Boil water before drinking.", "N": "Boil water for {N} minutes before drinking."}},
    "monitor": {"match": ["stay alert", "be alert", "stay informed", "listen for updates"],
      "text": {"": "Stay alert for updates."}},
    "all_clear": {"match": ["all clear", "danger has passed", "danger is over"],
      "text": {"": "All clear: the danger has passed."}}
  },
  "instructions": {
    "return": {"match": ["return", "go back", "come back"],
      "text": {"neg": "Do not return.", "neg|T": "Do not return until {T}.", "pos": "You may return."}},
    "use:elevators": {"match": ["use elevators", "use the elevators", "use elevator", "take the elevator"],
      "text": {"neg": "Do not use elevators."}},
    "drive:flood_water": {"match": ["drive through flood water", "drive through floodwater", "drive into flood water"],
      "text": {"neg": "Do not drive through flood water."}},
    "drink:tap_water": {"match": ["drink tap water", "drink the tap water"],
      "text": {"neg": "Do not drink tap water."}},
    "go:outside": {"match": ["go outside", "go outdoors"],
      "text": {"neg": "Do not go outside.", "neg|T": "Do not go outside until {T}."}},
    "light:fires": {"match": ["light fires", "light a fire", "use open flames"],
      "text": {"neg": "Do not light fires."}},
    "touch:power_lines": {"match": ["touch downed power lines", "touch power lines"],
      "text": {"neg": "Do not touch downed power lines."}},
    "open:door": {"match": ["open the door", "open doors"],
      "text": {"neg": "Do not open the door."}},
    "turn_off:gas": {"match": ["turn off the gas", "turn off gas", "shut off gas"],
      "text": {"pos": "Turn off the gas."}},
    "close:windows": {"match": ["close all windows", "close windows", "shut windows"],
      "text": {"pos": "Close all windows and doors."}},
    "lock:doors": {"match": ["lock all doors", "lock doors", "lock the doors"],
      "text": {"pos": "Lock all doors."}},
    "drop:cover": {"match": ["drop, cover", "drop cover"],
      "text": {"pos": "Drop, cover and hold on."}},
    "check:neighbors": {"match": ["check on your neighbors", "check on neighbors"],
      "text": {"pos": "Check on your neighbors."}},
    "drink:water": {"match": ["drink plenty of water", "stay hydrated"],
      "text": {"pos": "Drink plenty of water."}},
    "follow:officials": {"match": ["follow instructions", "follow official"],
      "text": {"pos": "Follow instructions from officials."}},
    "go:cooling_center": {"match": ["cooling center"],
      "text": {"pos|P": "Go to the cooling center at {P}."}},
    "go:shelter": {"match": ["go to the shelter", "go to a shelter", "evacuation center"],
      "text": {"pos|P": "Go to the shelter at {P}."}},
    "take:essentials": {"match": ["take medicine", "take medicines", "bring medicine", "important documents"],
      "text": {"pos": "Take medicine and important documents."}},
    "take:pets": {"match": ["take your pets", "bring your pets", "take pets"],
      "text": {"pos": "Take your pets with you."}},
    "call": {"match": ["call", "dial"],
      "text": {"pos|U": "Call {U}."}}
  },
  "info": {"match": ["info", "information", "more info", "details"], "text": "Info: {U}."},
  "expires": {"match": ["in effect until", "valid until", "expires", "until"], "text": "This alert is in effect until {T}."}
}
