# Copy to .env (backend) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# auto | anthropic | gemini | off
STENTOR_LLM=auto
ADAPTION_API_KEY=
ADAPTION_BASE_URL=https://api.prod.adaptionlabs.ai
# which model renders non template text: adaption | llm
STENTOR_RENDERER=llm
# Adaption model id after training
STENTOR_MODEL_ID=
# comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional platform settings
STENTOR_OPERATOR_TOKEN=
STENTOR_RATE_LIMIT=120
STENTOR_DUPLICATE_MINUTES=30
API_PUBLIC_URL=http://localhost:8000
