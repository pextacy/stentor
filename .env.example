# Copy to .env (backend) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
ADAPTION_API_KEY=
ADAPTION_BASE_URL=https://api.prod.adaptionlabs.ai
# which model renders non template text: adaption | llm
STENTOR_RENDERER=llm
# Adaption model id after training
STENTOR_MODEL_ID=
# comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
